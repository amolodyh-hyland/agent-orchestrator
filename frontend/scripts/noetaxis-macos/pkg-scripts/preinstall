#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && pwd)"
. "$script_dir/common.sh"

apps_dir="$(noetaxis_apps_dir)"
target_app="$apps_dir/$NOETAXIS_APP_NAME"
user_home="$(noetaxis_user_home)"
ao_home="$(noetaxis_ao_home)"

noetaxis_check_safe_origin 0
noetaxis_assert_idle "$target_app"
[[ -d "$apps_dir" ]] || { noetaxis_error "Applications directory does not exist: $apps_dir"; exit 29; }
[[ -n "$user_home" && -d "$user_home" ]] || { noetaxis_error "Could not resolve the human user's home directory."; exit 29; }
noetaxis_check_backup_space "$ao_home" "$user_home" "$apps_dir"

backup_dir="$(noetaxis_new_backup_dir "$user_home")"
noetaxis_copy_state_backup "$ao_home" "$backup_dir"
app_backup_name="NONE"
app_version="NONE"
if [[ -d "$target_app" ]]; then
	app_version="$(noetaxis_plist_value "$target_app/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || printf 'unknown')"
	app_backup_name="$(noetaxis_old_app_backup_name "$target_app")"
	noetaxis_run_privileged /bin/mv "$target_app" "$backup_dir/$app_backup_name"
fi
if ! noetaxis_write_backup_record "$backup_dir" "$app_backup_name" "$app_version"; then
	if [[ "$app_backup_name" != NONE && -d "$backup_dir/$app_backup_name" && ! -e "$target_app" ]]; then
		noetaxis_run_privileged /bin/mv "$backup_dir/$app_backup_name" "$target_app" || true
	fi
	noetaxis_error "Could not finalize the backup record. The previous app was restored when possible; backup data remains at $backup_dir"
	exit 35
fi
printf 'Agent Orchestrator backup created at %s\n' "$backup_dir"
