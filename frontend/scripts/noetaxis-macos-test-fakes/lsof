#!/bin/bash
SIM="${NOETAXIS_SIM:?}"
pid=""
cwd=0
while [[ "$#" -gt 0 ]]; do
	if [[ "$1" == -p ]]; then shift; pid="$1"; fi
	if [[ "$1" == cwd ]]; then cwd=1; fi
	shift
done
[[ -n "$pid" ]] || exit 1
printf 'p%s\n' "$pid"
if [[ "$cwd" -eq 1 ]]; then
	/usr/bin/awk -F '|' -v pid="$pid" '$1 == pid { print "fcwd\nn" substr($0, index($0, "|") + 1); found = 1; exit } END { if (!found) print "fcwd\nn/" }' "$SIM/cwds"
	exit 0
fi
while IFS='|' read -r row_pid mapping; do
	if [[ "$row_pid" == "$pid" ]]; then printf 'ftxt\nn%s\n' "$mapping"; fi
done < "$SIM/text-mappings"
