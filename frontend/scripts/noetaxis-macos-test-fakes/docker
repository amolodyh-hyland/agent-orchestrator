#!/bin/bash
. "${NOETAXIS_FAKES:?}/sim-lib.sh"
sim_log "docker $*"
case "$1" in
	ps)
		case "$*" in
			*Status*) /usr/bin/sed 's/$/\tUp 2 hours/' "$SIM/docker_containers" ;;
			*) cat "$SIM/docker_containers" ;;
		esac
		;;
	restart)
		if /usr/bin/grep -qxF "$2" "$SIM/cfg/docker_restart_fail" 2>/dev/null; then printf 'Error response from daemon\n' >&2; exit 1; fi
		exit 0
		;;
	*) exit 2 ;;
esac
