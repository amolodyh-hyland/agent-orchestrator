#!/bin/bash
# Fake bundled ao CLI: behaves according to the simulation directory, never to the real daemon.
. "${NOETAXIS_FAKES:?}/sim-lib.sh"
APP="${0%/Contents/Resources/daemon/ao}"
sim_log "ao[$APP] $* (AO_ vars in env: $(/usr/bin/env | /usr/bin/grep -c '^AO_'))"

daemon_up() { sim_app_running_daemon "$APP"; }
version() { /usr/bin/plutil -extract CFBundleShortVersionString raw -o - "$APP/Contents/Info.plist"; }

# Test hook: a helper call that hangs and ignores SIGTERM, to prove the watchdog ends it.
if [[ -f "$SIM/cfg/ao_hang" && "$*" == *"$(sim_value ao_hang)"* ]]; then
	sim_unlock
	trap '' TERM
	printf '%s' "$$" > "$SIM/hung.pid"
	# The test lease also ends this fake when a deliberately broken watchdog misses it.
	for _ in $(seq 1 3000); do
		[[ -f "${NOETAXIS_FIXTURE_ROOT:?}/.fixture-alive" ]] || break
		/bin/sleep 0.1
	done
	exit 1
fi

case "$1" in
	version) printf 'dev\n' ;;
	spawn)
		if sim_has no_effort_flag; then printf '  --model string\n'; else printf '  --effort string\n'; fi
		;;
	project) printf '  --permission-fallback\n' ;;
	status)
		# Test hook "N:id": on the Nth status call the host of session id is replaced by a new process while
		# the call is still running (the status call also sleeps, as a slow RPC would).
		status_calls=$(( $(cat "$SIM/status_calls" 2>/dev/null || echo 0) + 1 ))
		printf '%s' "$status_calls" > "$SIM/status_calls"
		if [[ "$status_calls" == "$(sim_value swap_host_on_status_call | /usr/bin/cut -d: -f1)" ]]; then
			swapped="$(sim_value swap_host_on_status_call | /usr/bin/cut -d: -f2)"
			/bin/sleep 0.3
			sim_remove_prefix "$APP/Contents/Resources/daemon/ao chat-host $swapped "
			sim_add_proc "$APP/Contents/Resources/daemon/ao chat-host $swapped $HOME/.ao/data $HOME/.ao/worktrees" > /dev/null
		fi
		if [[ -f "$SIM/cfg/exec_host_after_session_lists" && -f "$SIM/ls_calls" && "$(cat "$SIM/ls_calls")" -ge 2 ]]; then
			host_session="$(sim_value exec_host_after_session_lists)"
			host_pid="$(/usr/bin/awk -F '|' -v prefix="$APP/Contents/Resources/daemon/ao chat-host $host_session " 'index($2, prefix) == 1 { print $1; exit }' "$SIM/procs")"
			/usr/bin/awk -F '|' -v pid="$host_pid" -v executable="$SIM/foreign/ao" '$1 == pid { print $1 "|" executable; next } { print }' "$SIM/executables" > "$SIM/executables.tmp"
			/bin/mv "$SIM/executables.tmp" "$SIM/executables"
		fi
		# Test hook: a foreign or old daemon answers "ready" for this app, with its own binary path.
		if /usr/bin/grep -qxF "$(version)" "$SIM/cfg/foreign_status_versions" 2>/dev/null; then
			printf '{"state":"ready","pid":%s,"port":3999,"executablePath":"%s","runFile":"r","dataDir":"d"}\n' "$(sim_value foreign_status_pid)" "$(sim_value foreign_status_exe)"
		elif daemon_up; then
			state=ready
			if /usr/bin/grep -qxF "$(version)" "$SIM/cfg/unhealthy_versions" 2>/dev/null; then state=not_ready; fi
			max="$(sim_value "max_schema_$(version)")"
			if [[ -n "$max" && "$(sim_schema)" -gt "$max" ]]; then state=not_ready; fi
			daemon_pid="$(/usr/bin/awk -F '|' -v want="|$APP/Contents/Resources/daemon/ao daemon" 'index($0, want) { print $1; exit }' "$SIM/procs")"
			printf '{"state":"%s","pid":%s,"port":3999,"executablePath":"%s/Contents/Resources/daemon/ao","runFile":"r","dataDir":"d"}\n' "$state" "$daemon_pid" "$APP"
		else
			printf '{"state":"stopped","runFile":"r","dataDir":"d"}\n'
		fi
		;;
	stop)
		if ! sim_has stop_ineffective; then sim_stop_daemon "$APP"; fi
		printf 'AO daemon stopped\n'
		;;
	multica)
		daemon_up || { printf 'daemon is not running\n' >&2; exit 1; }
		if [[ "$(cat "$SIM/hosting" 2>/dev/null)" == on ]]; then
			printf '{"enabled":true,"state":"running","desired":"running","profile":"ao","healthPort":19514,"restarts":0}\n'
		else
			printf '{"enabled":false,"state":"disabled","desired":"","profile":"","healthPort":0,"restarts":0}\n'
		fi
		;;
	session)
		daemon_up || { printf 'AO daemon is not running\n' >&2; exit 1; }
		case "$2" in
			ls)
				# Test hook: a session that appears on the Nth "session ls" call.
				calls_so_far=$(( $(cat "$SIM/ls_calls" 2>/dev/null || echo 0) + 1 ))
				printf '%s' "$calls_so_far" > "$SIM/ls_calls"
				# Test hook "N:version": from the Nth list call on, a foreign daemon answers status for that app version.
				if [[ "$calls_so_far" == "$(sim_value foreign_on_ls_call | /usr/bin/cut -d: -f1)" ]]; then
					sim_value foreign_on_ls_call | /usr/bin/cut -d: -f2 > "$SIM/cfg/foreign_status_versions"
				fi
				# Test hook "N:id": the session id is re-created (new creation time) on the Nth list call.
				if [[ "$calls_so_far:" == "$(sim_value recreate_session_on_call | /usr/bin/cut -d: -f1):" ]]; then
					recreated="$(sim_value recreate_session_on_call | /usr/bin/cut -d: -f2)"
					/usr/bin/awk -F '|' -v OFS='|' -v id="$recreated" '$1 == id { $8 = "2026-10-09T09:09:09Z" } { print }' "$SIM/sessions" > "$SIM/sessions.tmp"
					/bin/mv "$SIM/sessions.tmp" "$SIM/sessions"
				fi
				if [[ "$calls_so_far" == "$(sim_value add_session_on_call)" ]]; then cat "$SIM/cfg/add_session_line" >> "$SIM/sessions"; fi
				if sim_has sessions_ls_fails; then printf 'internal error\n' >&2; exit 1; fi
				printf '{"data":['
				first=1
				while IFS='|' read -r id project role status activity terminated name created; do
					[[ -n "$id" ]] || continue
					if [[ "$role" == orchestrator && " $* " != *' --all '* && " $* " != *' -a '* ]]; then continue; fi
					[[ "$first" -eq 1 ]] || printf ','
					first=0
					printf '{"id":"%s","projectId":"%s","role":"%s","displayName":"%s","status":"%s","activity":"%s","isTerminated":%s,"harness":"claude","branch":"ao/%s","prs":[],"createdAt":"%s","updatedAt":"2026-10-01T00:00:00Z"}' "$id" "$project" "$role" "$(sim_json_escape "$name")" "$status" "$activity" "$terminated" "$id" "${created:-2026-10-01T00:00:00Z}"
				done < "$SIM/sessions"
				printf '],"meta":{"hiddenTerminatedCount":0,"hiddenOrchestratorCount":0}}\n'
				;;
			kill)
				# "ao session kill" tears the worktree down; update mode must never call it.
				sim_log "FORBIDDEN session kill"
				: > "$SIM/FORBIDDEN"
				exit 1
				;;
			exit-agent)
				id="$3"
				if [[ -f "$SIM/cfg/exit_agent_delay" ]]; then
					sim_log "exit-start $id"
					delay="$(sim_value exit_agent_delay)"
					sim_unlock; /bin/sleep "$delay"; sim_lock
					sim_log "exit-finish $id"
				fi
				if [[ -e "$SIM/cfg/exit_fail_$id" ]]; then printf 'could not stop the agent of %s\n' "$id" >&2; exit 1; fi
				/usr/bin/awk -F '|' -v OFS='|' -v id="$id" '$1 == id { $5 = "exited" } { print }' "$SIM/sessions" > "$SIM/sessions.tmp"
				/bin/mv "$SIM/sessions.tmp" "$SIM/sessions"
				sim_remove_prefix "$APP/Contents/Resources/daemon/ao chat-host $id "
				sim_end_session_agents "$id"
				if [[ -f "$SIM/cfg/foreign_after_exit_agent" ]]; then /bin/cp "$SIM/cfg/foreign_after_exit_agent" "$SIM/cfg/foreign_status_versions"; fi
				# Test hook: another session is re-created (new generation) while the batch runs.
				if [[ -f "$SIM/cfg/recreate_created_on_exit_agent" ]]; then
					/usr/bin/awk -F '|' -v OFS='|' -v id="$(sim_value recreate_created_on_exit_agent)" '$1 == id { $8 = "2026-10-09T09:09:09Z" } { print }' "$SIM/sessions" > "$SIM/sessions.tmp"
					/bin/mv "$SIM/sessions.tmp" "$SIM/sessions"
				fi
				# Test hook: another session's host is replaced by a new process while the batch runs.
				if [[ -f "$SIM/cfg/replace_host_on_exit_agent" ]]; then
					replaced="$(sim_value replace_host_on_exit_agent)"
					sim_remove_prefix "$APP/Contents/Resources/daemon/ao chat-host $replaced "
					sim_add_proc "$APP/Contents/Resources/daemon/ao chat-host $replaced $HOME/.ao/data $HOME/.ao/worktrees" > /dev/null
				fi
				if [[ -f "$SIM/cfg/spawn_host_on_exit_agent" ]]; then sim_add_proc "$APP/Contents/Resources/daemon/ao chat-host $(sim_value spawn_host_on_exit_agent) $HOME/.ao/data $HOME/.ao/worktrees" > /dev/null; fi
				printf 'agent exited for session %s\n' "$id"
				;;
			restore)
				id="$3"
				if [[ -e "$SIM/cfg/restore_fail_$id" ]]; then printf 'cannot restore %s\n' "$id" >&2; exit 1; fi
				if [[ ! -e "$SIM/cfg/restore_noop_$id" ]]; then
					/usr/bin/awk -F '|' -v OFS='|' -v id="$id" '$1 == id { $5 = "active"; $6 = "false" } { print }' "$SIM/sessions" > "$SIM/sessions.tmp"
					/bin/mv "$SIM/sessions.tmp" "$SIM/sessions"
					sim_add_proc "$APP/Contents/Resources/daemon/ao chat-host $id $HOME/.ao/data $HOME/.ao/worktrees" > /dev/null
				fi
				printf 'session %s restored\n' "$id"
				;;
			*) exit 2 ;;
		esac
		;;
	*) exit 2 ;;
esac
