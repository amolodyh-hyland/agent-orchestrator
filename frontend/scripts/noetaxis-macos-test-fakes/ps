#!/bin/bash
. "${NOETAXIS_FAKES:?}/sim-lib.sh"
pid="${@: -1}"
if [[ "$*" == *'-axo '* ]]; then
	sim_tick
	while IFS='|' read -r row command; do
		[[ -n "$row" ]] || continue
		parent="$(sim_ppid_of "$row")"
		if [[ -f "$SIM/cfg/lstart_$row" ]]; then start="$(cat "$SIM/cfg/lstart_$row")"; else start="Mon Oct 12 00:00:$(printf '%02d' "$((row % 60))") 2026"; fi
		printf '%s %s %s %s\n' "$row" "$parent" "$start" "$command"
	done < "$SIM/procs"
	exit 0
fi
case "$*" in
	*pid=*ppid=*lstart=*command=*)
		sim_tick
		command="$(sim_command_of "$pid")"
		[[ -n "$command" ]] || exit 1
		parent="$(sim_ppid_of "$pid")"
		if [[ -f "$SIM/cfg/lstart_$pid" ]]; then start="$(cat "$SIM/cfg/lstart_$pid")"; else start="Mon Oct 12 00:00:$(printf '%02d' "$((pid % 60))") 2026"; fi
		printf '%s %s %s %s\n' "$pid" "$parent" "$start" "$command"
		;;
	*command=*)
		command="$(sim_command_of "$pid")"
		[[ -n "$command" ]] || exit 1
		printf '%s\n' "$command"
		;;
	*lstart=*)
		[[ -n "$(sim_command_of "$pid")" ]] || exit 1
		if [[ -f "$SIM/cfg/lstart_$pid" ]]; then cat "$SIM/cfg/lstart_$pid"; else printf 'Mon Oct 12 00:00:%02d 2026\n' "$((pid % 60))"; fi
		;;
	*ppid=*) sim_ppid_of "$pid"; printf '\n' ;;
	# Plain "ps -p <pid>" (the lock's liveness check): real process liveness, so the lock tests do not
	# depend on what the host sandbox lets /bin/ps do.
	*"-p "*)
		if /bin/kill -0 "$pid" 2>/dev/null; then printf '  PID TTY           TIME CMD\n%s ??         0:00.00 x\n' "$pid"; exit 0; fi
		exit 1
		;;
	*) exit 1 ;;
esac
