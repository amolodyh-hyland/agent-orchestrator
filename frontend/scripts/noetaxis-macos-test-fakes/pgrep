#!/bin/bash
. "${NOETAXIS_FAKES:?}/sim-lib.sh"
sim_tick
args=("$@")
pattern="${args[${#args[@]}-1]}"
if [[ "$pattern" == *codex* ]]; then sim_log "agent-probe $(/bin/date '+%s')"; fi
status=1
grep_flags=-Eq
[[ "$1" == -*i* ]] && grep_flags=-Eiq
while IFS='|' read -r pid command; do
	[[ -n "$pid" ]] || continue
	if printf '%s' "$command" | /usr/bin/grep "$grep_flags" -- "$pattern"; then
		status=0
		case "$1" in
			-*l*) printf '%s %s\n' "$pid" "$command" ;;
			*) printf '%s\n' "$pid" ;;
		esac
	fi
done < "$SIM/procs"
exit "$status"
